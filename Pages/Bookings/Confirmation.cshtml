@page "{id:int}"
@model TravelDemo.Pages.Bookings.ConfirmationModel
@{
    ViewData["Title"] = "Booking Confirmation Ticket";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Success Banner -->
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success rounded-circle p-3 mb-3" style="width: 70px; height: 70px;">
                    <i class="fa-solid fa-circle-check fa-3x"></i>
                </div>
                <h2 class="fw-bold text-dark mb-1">Reservation Confirmed!</h2>
                <p class="text-secondary">Pack your bags! Your expedition seats are locked and secured.</p>
            </div>

            <!-- Digital Boarding Ticket -->
            <div class="ticket-box">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pb-3 mb-3 border-bottom">
                    <div>
                        <span class="text-uppercase text-muted small fw-bold tracking-wider">Booking Reference</span>
                        <div class="fs-4 fw-bold text-primary font-mono">#WND-@Model.Booking.Id.ToString("D6")</div>
                    </div>
                    <div>
                        <span class="status-badge confirmed">
                            <i class="fa-solid fa-check me-1"></i> @Model.Booking.Status
                        </span>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-7">
                        <span class="text-uppercase text-muted small fw-bold">Expedition Package</span>
                        <h4 class="fw-bold text-dark mb-1">@Model.Booking.Departure?.TravelPackage?.Title</h4>
                        <div class="text-secondary small">
                            <i class="fa-solid fa-location-dot text-primary me-1"></i> @Model.Booking.Departure?.TravelPackage?.Destination?.Name
                        </div>
                    </div>
                    <div class="col-md-5 text-md-end">
                        <span class="text-uppercase text-muted small fw-bold">Departure Date</span>
                        <h5 class="fw-bold text-dark mb-0">@Model.Booking.Departure?.StartDate.ToString("dd MMMM yyyy")</h5>
                        <div class="text-muted small">Duration: @Model.Booking.Departure?.TravelPackage?.DurationDays Days</div>
                    </div>
                </div>

                <div class="bg-light rounded-3 p-3 mb-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="text-muted small">Lead Passenger</div>
                            <div class="fw-bold text-dark">@Model.Booking.LeadName</div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-muted small">Contact Phone</div>
                            <div class="fw-bold text-dark">@Model.Booking.Phone</div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-muted small">Total Travellers</div>
                            <div class="fw-bold text-dark">@Model.Booking.Travellers Person(s)</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <div>
                        <span class="text-muted small">Booking Total Paid</span>
                        <div class="fs-3 fw-bold text-success">$@Model.Booking.TotalPrice.ToString("N2")</div>
                    </div>
                    <div class="text-center">
                        <div class="p-2 border bg-white rounded-2 d-inline-block">
                            <i class="fa-solid fa-qrcode fa-3x text-dark"></i>
                        </div>
                        <div class="small text-muted mt-1">Scan Ticket</div>
                    </div>
                </div>
            </div>

            <!-- Action buttons -->
            <div class="d-flex justify-content-center gap-3 mt-4">
                <a asp-page="/Bookings/Index" class="btn btn-wl-primary">
                    <i class="fa-solid fa-ticket me-1"></i> View All My Bookings
                </a>
                <button onclick="window.print()" class="btn btn-wl-outline">
                    <i class="fa-solid fa-print me-1"></i> Print Ticket
                </button>
            </div>
        </div>
    </div>
</div>
