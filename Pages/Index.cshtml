@page
@model IndexModel
@{
    ViewData["Title"] = "Discover Extraordinary Journeys";
}

<!-- Hero Section -->
<div class="hero-wrapper">
    <div class="container text-center">
        <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50 rounded-pill px-3 py-2 mb-3">
            <i class="fa-solid fa-compass me-1"></i> ASP.NET Core 10 Travel Platform
        </span>
        <h1 class="hero-title">
            Explore the World’s Most <span>Breathtaking</span> Destinations
        </h1>
        <p class="hero-subtitle mx-auto">
            Small group luxury expeditions, curated itineraries, guaranteed departure seats, and unforgettable memory-making adventures.
        </p>

        <div class="hero-stats d-flex justify-content-center gap-4 flex-wrap mt-4">
            <div><i class="fa-solid fa-map-location-dot text-warning me-2"></i><strong>50+</strong> Destinations</div>
            <div><i class="fa-solid fa-users text-warning me-2"></i><strong>10,000+</strong> Happy Travelers</div>
            <div><i class="fa-solid fa-star text-warning me-2"></i><strong>4.9/5</strong> Traveler Rating</div>
        </div>
    </div>
</div>

<!-- Floating Interactive Search Widget -->
<div class="container">
    <div class="search-card">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-lg-4 col-md-6">
                <label class="form-label small fw-bold text-uppercase text-secondary mb-1">
                    <i class="fa-solid fa-magnifying-glass me-1 text-primary"></i> Search Keyword
                </label>
                <input type="text" asp-for="Search" class="form-control search-input" placeholder="e.g. Bali, Swiss Alps, Kyoto..." />
            </div>

            <div class="col-lg-3 col-md-6">
                <label class="form-label small fw-bold text-uppercase text-secondary mb-1">
                    <i class="fa-solid fa-tags me-1 text-primary"></i> Category
                </label>
                <select asp-for="Category" class="form-select search-input">
                    <option value="">All Experience Types</option>
                    @foreach (var cat in Enum.GetNames(typeof(TravelDemo.Models.PackageCategory)))
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
            </div>

            <div class="col-lg-3 col-md-6">
                <label class="form-label small fw-bold text-uppercase text-secondary mb-1">
                    <i class="fa-solid fa-dollar-sign me-1 text-primary"></i> Max Budget ($)
                </label>
                <input type="number" asp-for="MaxPrice" class="form-control search-input" placeholder="e.g. 2500" step="100" />
            </div>

            <div class="col-lg-2 col-md-6 d-flex align-items-end">
                <button type="submit" class="btn btn-wl-primary w-100 py-2 justify-content-center">
                    <i class="fa-solid fa-paper-plane me-1"></i> Search
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Category Pills Filter -->
<div class="container mt-5">
    <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap">
        <a asp-page="/Index" class="category-pill @(string.IsNullOrEmpty(Model.Category) ? "active" : "")">
            <i class="fa-solid fa-globe"></i> All Trips
        </a>
        @foreach (var cat in Enum.GetNames(typeof(TravelDemo.Models.PackageCategory)))
        {
            <a asp-page="/Index" asp-route-category="@cat" class="category-pill @(Model.Category == cat ? "active" : "")">
                @switch (cat)
                {
                    case "Adventure": <i class="fa-solid fa-mountain"></i> break;
                    case "Beach": <i class="fa-solid fa-umbrella-beach"></i> break;
                    case "Culture": <i class="fa-solid fa-landmark"></i> break;
                    case "Luxury": <i class="fa-solid fa-crown"></i> break;
                    case "Family": <i class="fa-solid fa-people-group"></i> break;
                    case "Wellness": <i class="fa-solid fa-spa"></i> break;
                    default: <i class="fa-solid fa-compass"></i> break;
                }
                @cat
            </a>
        }
    </div>
</div>

<!-- Featured Travel Packages Grid -->
<div class="container my-5">
    <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-2">
        <div>
            <span class="text-uppercase text-primary fw-bold small tracking-wide">Top Rated Expeditions</span>
            <h2 class="mb-0 fs-2 fw-bold">Handcrafted Travel Packages</h2>
        </div>
        <a asp-page="/Packages/Index" class="btn btn-wl-outline">
            View All Packages <i class="fa-solid fa-arrow-right ms-1"></i>
        </a>
    </div>

    @if (!Model.FeaturedPackages.Any())
    {
        <div class="alert alert-warning text-center p-5 rounded-4 shadow-sm">
            <i class="fa-solid fa-circle-exclamation fa-2x mb-3 text-warning"></i>
            <h4>No travel packages found matching your criteria</h4>
            <p class="text-secondary">Try clearing your search filter or selecting a different travel category.</p>
            <a asp-page="/Index" class="btn btn-wl-primary mt-2">Reset All Filters</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var pkg in Model.FeaturedPackages)
            {
                var nextDep = pkg.Departures.Where(d => d.StartDate >= DateOnly.FromDateTime(DateTime.Today)).OrderBy(d => d.StartDate).FirstOrDefault();
                <div class="col-lg-4 col-md-6">
                    <div class="package-card">
                        <div class="package-img-wrapper">
                            <img src="@pkg.ImageUrl" alt="@pkg.Title" class="package-img" loading="lazy" />
                            <span class="package-badge-category">@pkg.Category</span>
                            <span class="package-badge-price">$@pkg.PricePerPerson.ToString("N0")</span>
                        </div>
                        <div class="package-content">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="text-warning small fw-bold">
                                    <i class="fa-solid fa-star me-1"></i>@pkg.Rating.ToString("0.0")
                                </span>
                                <span class="text-muted small">•</span>
                                <span class="text-secondary small fw-medium">
                                    <i class="fa-solid fa-location-dot me-1 text-primary"></i>@pkg.Destination?.Name
                                </span>
                            </div>
                            <h3 class="package-title">
                                <a asp-page="/Packages/Details" asp-route-id="@pkg.Id" class="text-decoration-none text-dark">
                                    @pkg.Title
                                </a>
                            </h3>
                            <p class="package-summary">@pkg.Summary</p>

                            <div class="package-meta">
                                <div>
                                    <i class="fa-regular fa-clock me-1"></i> @pkg.DurationDays Days
                                </div>
                                <div>
                                    <i class="fa-solid fa-users me-1"></i> Max @pkg.MaxGroupSize
                                </div>
                                @if (nextDep != null)
                                {
                                    <div>
                                        @if (nextDep.SeatsLeft <= 3 && nextDep.SeatsLeft > 0)
                                        {
                                            <span class="seat-badge low">@nextDep.SeatsLeft seats left!</span>
                                        }
                                        else if (nextDep.SeatsLeft == 0)
                                        {
                                            <span class="seat-badge full">Sold Out</span>
                                        }
                                        else
                                        {
                                            <span class="seat-badge available">@nextDep.SeatsLeft seats available</span>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="mt-3 pt-3 border-top d-flex gap-2">
                                <a asp-page="/Packages/Details" asp-route-id="@pkg.Id" class="btn btn-wl-primary w-100 justify-content-center">
                                    View Details <i class="fa-solid fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Top Destinations Showcase -->
<div class="bg-white py-5 border-top border-bottom my-5">
    <div class="container">
        <div class="text-center mb-5">
            <span class="text-uppercase text-primary fw-bold small tracking-wide">Featured Spots</span>
            <h2 class="fs-2 fw-bold">Popular Destinations</h2>
            <p class="text-secondary">Discover incredible landscapes, vibrant cultures, and historic landmarks.</p>
        </div>

        <div class="row g-4">
            @foreach (var dest in Model.Destinations)
            {
                <div class="col-lg-4 col-md-6">
                    <a asp-page="/Destinations/Details" asp-route-id="@dest.Id" class="dest-card">
                        <img src="@dest.ImageUrl" alt="@dest.Name" class="dest-img" loading="lazy" />
                        <div class="dest-overlay">
                            <span class="dest-region">@dest.Country • @dest.Region</span>
                            <h3 class="dest-name">@dest.Name</h3>
                            <span class="small text-info fw-bold mt-1">
                                <i class="fa-solid fa-suitcase me-1"></i> @dest.Packages.Count Travel Packages
                            </span>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Why Choose Wanderlust Section -->
<div class="container my-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <span class="text-uppercase text-primary fw-bold small tracking-wide">The Wanderlust Advantage</span>
            <h2 class="fs-2 fw-bold mb-4">Why Modern Travelers Choose Us</h2>
            <div class="d-flex gap-3 mb-4">
                <div class="icon-box flex-shrink-0">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div>
                    <h5 class="fw-bold">Concurrency-Safe Seat Reservation</h5>
                    <p class="text-secondary mb-0">Our ASP.NET Core EF Core backend guarantees real-time seat locks and prevents double-booking issues during peak checkout.</p>
                </div>
            </div>
            <div class="d-flex gap-3 mb-4">
                <div class="icon-box flex-shrink-0" style="background: #fef3c7; color: #d97706;">
                    <i class="fa-solid fa-gem"></i>
                </div>
                <div>
                    <h5 class="fw-bold">Bespoke Small Group Privacy</h5>
                    <p class="text-secondary mb-0">Never travel in overcrowded buses. We cap our group sizes to a max of 12 passengers for intimate, high-end experiences.</p>
                </div>
            </div>
            <div class="d-flex gap-3">
                <div class="icon-box flex-shrink-0" style="background: #e0e7ff; color: #4338ca;">
                    <i class="fa-solid fa-headset"></i>
                </div>
                <div>
                    <h5 class="fw-bold">24/7 On-Ground Support</h5>
                    <p class="text-secondary mb-0">Dedicated trip directors and local expedition guides ensure your safety and comfort at every leg of the journey.</p>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="position-relative">
                <img src="https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?auto=format&fit=crop&w=1000&q=80" alt="Traveler" class="img-fluid rounded-4 shadow-xl" />
                <div class="position-absolute bottom-0 start-0 m-4 p-3 bg-white bg-opacity-95 backdrop-blur rounded-3 shadow-lg border">
                    <div class="d-flex align-items-center gap-3">
                        <div class="text-warning fs-3"><i class="fa-solid fa-award"></i></div>
                        <div>
                            <div class="fw-bold text-dark">Award-Winning Platform</div>
                            <div class="small text-secondary">Best Travel Booking Experience 2026</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
