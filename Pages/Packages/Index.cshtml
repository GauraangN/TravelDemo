@page
@model TravelDemo.Pages.Packages.IndexModel
@{
    ViewData["Title"] = "Explore All Travel Packages";
}

<!-- Page Header Banner -->
<div class="bg-dark text-white py-5 mb-4 position-relative overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
    <div class="container text-center position-relative z-1 py-3">
        <h1 class="fw-bold fs-1">All Expeditions & Packages</h1>
        <p class="text-slate-400 max-w-2xl mx-auto">
            Browse our complete collection of curated itineraries across Asia, Europe, Africa, and the Americas.
        </p>
    </div>
</div>

<div class="container mb-5">
    <div class="row g-4">
        <!-- Sidebar Filter -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 90px; z-index: 10;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-sliders text-primary me-2"></i>Filter Trips
                    </h5>
                    <a asp-page="/Packages/Index" class="small text-muted text-decoration-none">Reset</a>
                </div>
                <form method="get">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase text-secondary">Search Keyword</label>
                        <input type="text" asp-for="Search" class="form-control form-control-sm" placeholder="e.g. Manta, Glacier..." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase text-secondary">Category</label>
                        <select asp-for="Category" class="form-select form-select-sm">
                            <option value="">All Categories</option>
                            @foreach (var cat in Enum.GetNames(typeof(TravelDemo.Models.PackageCategory)))
                            {
                                <option value="@cat">@cat</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase text-secondary">Destination</label>
                        <select asp-for="DestinationId" class="form-select form-select-sm">
                            <option value="">All Destinations</option>
                            @foreach (var d in Model.Destinations)
                            {
                                <option value="@d.Id">@d.Name (@d.Country)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase text-secondary">Max Budget ($)</label>
                        <input type="number" asp-for="MaxPrice" class="form-control form-control-sm" placeholder="Max price per person" step="100" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-uppercase text-secondary">Sort By</label>
                        <select asp-for="SortBy" class="form-select form-select-sm">
                            <option value="">Featured & Top Rated</option>
                            <option value="PriceAsc">Price: Low to High</option>
                            <option value="PriceDesc">Price: High to Low</option>
                            <option value="Rating">Highest Rating</option>
                            <option value="Duration">Trip Duration</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-wl-primary w-100 justify-content-center">
                        <i class="fa-solid fa-filter me-1"></i> Apply Filters
                    </button>
                </form>
            </div>
        </div>

        <!-- Main Package Grid -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-secondary fw-semibold">
                    Showing <strong>@Model.Packages.Count</strong> package(s)
                </span>
            </div>

            @if (!Model.Packages.Any())
            {
                <div class="alert alert-warning text-center p-5 rounded-4 shadow-sm">
                    <i class="fa-solid fa-face-frown fa-2x mb-3 text-warning"></i>
                    <h4>No matching packages found</h4>
                    <p class="text-secondary">Try relaxing your search terms or price filter.</p>
                    <a asp-page="/Packages/Index" class="btn btn-wl-primary mt-2">Clear Filters</a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var pkg in Model.Packages)
                    {
                        var nextDep = pkg.Departures.Where(d => d.StartDate >= DateOnly.FromDateTime(DateTime.Today)).OrderBy(d => d.StartDate).FirstOrDefault();
                        <div class="col-md-6">
                            <div class="package-card">
                                <div class="package-img-wrapper">
                                    <img src="@pkg.ImageUrl" alt="@pkg.Title" class="package-img" loading="lazy" />
                                    <span class="package-badge-category">@pkg.Category</span>
                                    <span class="package-badge-price">$@pkg.PricePerPerson.ToString("N0")</span>
                                </div>
                                <div class="package-content">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <span class="text-warning small fw-bold">
                                            <i class="fa-solid fa-star me-1"></i>@pkg.Rating.ToString("0.0")
                                        </span>
                                        <span class="text-muted small">•</span>
                                        <span class="text-secondary small fw-medium">
                                            <i class="fa-solid fa-location-dot me-1 text-primary"></i>@pkg.Destination?.Name
                                        </span>
                                    </div>
                                    <h3 class="package-title">
                                        <a asp-page="/Packages/Details" asp-route-id="@pkg.Id" class="text-decoration-none text-dark">
                                            @pkg.Title
                                        </a>
                                    </h3>
                                    <p class="package-summary">@pkg.Summary</p>

                                    <!-- Inclusions preview badges -->
                                    @if (!string.IsNullOrEmpty(pkg.Inclusions))
                                    {
                                        <div class="d-flex flex-wrap gap-1 mb-3">
                                            @foreach (var inc in pkg.Inclusions.Split(',').Take(3))
                                            {
                                                <span class="badge bg-light text-secondary border fw-medium px-2 py-1">
                                                    <i class="fa-solid fa-check text-success me-1"></i>@inc.Trim()
                                                </span>
                                            }
                                        </div>
                                    }

                                    <div class="package-meta mt-auto">
                                        <div>
                                            <i class="fa-regular fa-clock me-1"></i> @pkg.DurationDays Days
                                        </div>
                                        <div>
                                            <i class="fa-solid fa-users me-1"></i> Max @pkg.MaxGroupSize
                                        </div>
                                        @if (nextDep != null)
                                        {
                                            <div>
                                                @if (nextDep.SeatsLeft <= 3 && nextDep.SeatsLeft > 0)
                                                {
                                                    <span class="seat-badge low">@nextDep.SeatsLeft seats left!</span>
                                                }
                                                else if (nextDep.SeatsLeft == 0)
                                                {
                                                    <span class="seat-badge full">Sold Out</span>
                                                }
                                                else
                                                {
                                                    <span class="seat-badge available">@nextDep.SeatsLeft seats</span>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div class="mt-3 pt-3 border-top">
                                        <a asp-page="/Packages/Details" asp-route-id="@pkg.Id" class="btn btn-wl-primary w-100 justify-content-center">
                                            Explore Package <i class="fa-solid fa-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
