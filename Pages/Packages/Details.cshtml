@page "{id:int}"
@model TravelDemo.Pages.Packages.DetailsModel
@{
    ViewData["Title"] = Model.Package.Title;
}

<!-- Package Hero Banner -->
<div class="position-relative bg-dark text-white py-5" style="background: linear-gradient(rgba(15, 23, 42, 0.75), rgba(15, 23, 42, 0.9)), url('@Model.Package.ImageUrl') center/cover no-repeat;">
    <div class="container py-4">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge bg-info text-dark font-mono uppercase font-bold px-3 py-1">@Model.Package.Category</span>
            <span class="text-warning fw-bold"><i class="fa-solid fa-star me-1"></i>@Model.Package.Rating.ToString("0.0") Rating</span>
            <span class="text-slate-300">•</span>
            <span class="text-slate-300"><i class="fa-solid fa-location-dot text-info me-1"></i>@Model.Package.Destination?.Name (@Model.Package.Destination?.Country)</span>
        </div>
        <h1 class="display-5 fw-bold text-white mb-3">@Model.Package.Title</h1>
        <p class="lead text-slate-200 max-w-3xl mb-4">@Model.Package.Summary</p>

        <div class="d-flex flex-wrap gap-4 align-items-center">
            <div class="bg-white bg-opacity-10 backdrop-blur rounded-3 p-3 px-4 text-center border border-white border-opacity-20">
                <div class="small text-slate-300">Price per Person</div>
                <div class="fs-2 fw-bold text-info">$@Model.Package.PricePerPerson.ToString("N0")</div>
            </div>
            <div class="bg-white bg-opacity-10 backdrop-blur rounded-3 p-3 px-4 text-center border border-white border-opacity-20">
                <div class="small text-slate-300">Duration</div>
                <div class="fs-2 fw-bold text-white">@Model.Package.DurationDays Days</div>
            </div>
            <div class="bg-white bg-opacity-10 backdrop-blur rounded-3 p-3 px-4 text-center border border-white border-opacity-20">
                <div class="small text-slate-300">Max Group Size</div>
                <div class="fs-2 fw-bold text-white">@Model.Package.MaxGroupSize People</div>
            </div>
        </div>
    </div>
</div>

<div class="container my-5">
    <div class="row g-5">
        <!-- Left Content: Overview, Inclusions, Day-by-day Itinerary -->
        <div class="col-lg-8">
            <!-- Package Inclusions -->
            <div class="bg-white rounded-4 p-4 shadow-sm mb-5 border">
                <h4 class="fw-bold mb-3">
                    <i class="fa-solid fa-gift text-primary me-2"></i>What's Included
                </h4>
                <div class="row g-3">
                    @if (!string.IsNullOrEmpty(Model.Package.Inclusions))
                    {
                        @foreach (var inc in Model.Package.Inclusions.Split(','))
                        {
                            <div class="col-md-6 d-flex align-items-center gap-2">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="fa-solid fa-check fs-6"></i>
                                </div>
                                <span class="fw-medium text-dark">@inc.Trim()</span>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Day-by-Day Itinerary -->
            <h4 class="fw-bold mb-4">
                <i class="fa-solid fa-map-location-dot text-primary me-2"></i>Day-by-Day Expedition Itinerary
            </h4>
            
            <div class="itinerary-timeline">
                @foreach (var day in Model.Package.Itinerary)
                {
                    <div class="itinerary-day-item">
                        <div class="itinerary-day-node">@day.DayNumber</div>
                        <div class="itinerary-card">
                            <h5 class="fw-bold text-dark mb-2">Day @day.DayNumber: @day.Title</h5>
                            <p class="text-secondary mb-0">@day.Description</p>
                        </div>
                    </div>
                }
            </div>

            <!-- Destination Info Box -->
            @if (Model.Package.Destination != null)
            {
                <div class="bg-light rounded-4 p-4 mt-5 border d-flex gap-4 align-items-center flex-wrap">
                    <img src="@Model.Package.Destination.ImageUrl" alt="@Model.Package.Destination.Name" class="rounded-3 object-fit-cover" style="width: 120px; height: 100px;" />
                    <div>
                        <h5 class="fw-bold text-dark mb-1">About @Model.Package.Destination.Name</h5>
                        <p class="text-secondary small mb-0">@Model.Package.Destination.Description</p>
                    </div>
                </div>
            }
        </div>

        <!-- Right Content: Departure Selector & Interactive Booking Widget -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-lg rounded-4 p-4 sticky-top" style="top: 90px; z-index: 10;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold mb-0">Book Your Trip</h4>
                    <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-1">Instant Lock</span>
                </div>
                <hr />

                <form method="get" asp-page="/Bookings/Create">
                    <input type="hidden" name="packageId" value="@Model.Package.Id" />

                    <!-- Departure Selection -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-uppercase small text-secondary">Select Departure Date</label>
                        @if (!Model.Package.Departures.Any())
                        {
                            <div class="alert alert-warning small">No scheduled departures currently available.</div>
                        }
                        else
                        {
                            <div class="d-flex flex-direction-column gap-2 flex-column">
                                @foreach (var dep in Model.Package.Departures)
                                {
                                    var isSelected = (Model.SelectedDepartureId == dep.Id);
                                    var isDisabled = (dep.SeatsLeft <= 0);
                                    <div class="card p-3 border @(isSelected ? "border-primary bg-primary bg-opacity-10" : "") @(isDisabled ? "bg-light opacity-50" : "")" style="cursor: pointer;" onclick="document.getElementById('dep_@dep.Id').click();">
                                        <div class="form-check d-flex align-items-center justify-content-between">
                                            <div>
                                                <input class="form-check-input me-2" type="radio" name="departureId" id="dep_@dep.Id" value="@dep.Id" @(isSelected ? "checked" : "") @(isDisabled ? "disabled" : "") onchange="updatePrice();" />
                                                <label class="form-check-label fw-bold" for="dep_@dep.Id">
                                                    @dep.StartDate.ToString("dd MMMM yyyy")
                                                </label>
                                            </div>
                                            <div>
                                                @if (dep.SeatsLeft <= 0)
                                                {
                                                    <span class="seat-badge full">Sold Out</span>
                                                }
                                                else if (dep.SeatsLeft <= 3)
                                                {
                                                    <span class="seat-badge low">@dep.SeatsLeft left</span>
                                                }
                                                else
                                                {
                                                    <span class="seat-badge available">@dep.SeatsLeft left</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <!-- Traveller Count Selector -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-uppercase small text-secondary">Number of Travellers</label>
                        <div class="input-group">
                            <button type="button" class="btn btn-outline-secondary" onclick="changeTravellers(-1)">-</button>
                            <input type="number" id="travellerInput" name="travellers" class="form-control text-center fw-bold" value="1" min="1" max="@Model.Package.MaxGroupSize" onchange="updatePrice()" readonly />
                            <button type="button" class="btn btn-outline-secondary" onclick="changeTravellers(1)">+</button>
                        </div>
                        <div class="form-text small text-muted">Max @Model.Package.MaxGroupSize travellers per group.</div>
                    </div>

                    <!-- Live Total Price Breakdown -->
                    <div class="bg-light p-3 rounded-3 mb-4">
                        <div class="d-flex justify-content-between text-secondary small mb-1">
                            <span>Price per person</span>
                            <span>$@Model.Package.PricePerPerson.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between text-secondary small mb-2">
                            <span>Travellers</span>
                            <span id="travellersDisplay">1</span>
                        </div>
                        <hr class="my-2" />
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold text-dark fs-6">Estimated Total</span>
                            <span class="fs-4 fw-bold text-primary" id="totalPriceDisplay">$@Model.Package.PricePerPerson.ToString("N0")</span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-wl-primary w-100 py-3 justify-content-center fs-6">
                        <i class="fa-solid fa-lock me-2"></i> Continue to Checkout
                    </button>
                </form>

                <div class="mt-3 text-center">
                    <span class="small text-muted"><i class="fa-solid fa-shield-cat me-1 text-success"></i> Real-time concurrency protection active</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const unitPrice = @Model.Package.PricePerPerson;

        function changeTravellers(delta) {
            const input = document.getElementById('travellerInput');
            let current = parseInt(input.value) || 1;
            let max = parseInt(input.getAttribute('max')) || 12;
            let next = current + delta;
            if (next >= 1 && next <= max) {
                input.value = next;
                updatePrice();
            }
        }

        function updatePrice() {
            const travellers = parseInt(document.getElementById('travellerInput').value) || 1;
            document.getElementById('travellersDisplay').innerText = travellers;
            const total = travellers * unitPrice;
            document.getElementById('totalPriceDisplay').innerText = '$' + total.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
        }
    </script>
}
