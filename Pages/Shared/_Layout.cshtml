@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Wanderlust Expeditions</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- Demo Banner -->
    <div class="demo-user-banner">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <i class="fa-solid fa-sparkles text-info me-1"></i>
                <strong>ASP.NET Core 10 Demo:</strong> Wanderlust Luxury & Adventure Travel Platform
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="d-none d-md-inline text-slate-400">Quick Test Credentials:</span>
                <span class="wl-badge-demo" title="Customer Login">
                    <i class="fa-solid fa-user me-1"></i> alex@traveler.com / Traveler123!
                </span>
                <span class="wl-badge-demo" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b; border-color: rgba(245, 158, 11, 0.3);" title="Admin Login">
                    <i class="fa-solid fa-user-shield me-1"></i> admin@wanderlust.com / Admin123!
                </span>
            </div>
        </div>
    </div>

    <!-- Header / Navigation Bar -->
    <header>
        <nav class="navbar navbar-expand-lg wl-navbar navbar-dark">
            <div class="container">
                <a class="wl-brand" asp-area="" asp-page="/Index">
                    <i class="fa-solid fa-compass text-info me-1"></i> Wanderlust
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#wlNavbarContent" aria-controls="wlNavbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="wlNavbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                        <li class="nav-item">
                            <a class="wl-nav-link" asp-area="" asp-page="/Index">
                                <i class="fa-solid fa-house me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="wl-nav-link" asp-area="" asp-page="/Destinations/Index">
                                <i class="fa-solid fa-earth-americas me-1"></i> Destinations
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="wl-nav-link" asp-area="" asp-page="/Packages/Index">
                                <i class="fa-solid fa-suitcase-rolling me-1"></i> Travel Packages
                            </a>
                        </li>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="wl-nav-link" asp-area="" asp-page="/Bookings/Index">
                                    <i class="fa-solid fa-ticket me-1"></i> My Bookings
                                </a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="wl-nav-link text-warning fw-bold" asp-area="" asp-page="/Admin/Index">
                                        <i class="fa-solid fa-sliders me-1"></i> Admin Portal
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-light dropdown-toggle rounded-pill px-3" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-regular fa-user-circle me-1 text-info"></i> @User.Identity?.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userMenu">
                                    <li>
                                        <a class="dropdown-menu-item dropdown-item" asp-page="/Bookings/Index">
                                            <i class="fa-solid fa-receipt me-2 text-primary"></i> My Trips
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="fa-solid fa-right-from-bracket me-2"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-light rounded-pill px-3" asp-area="Identity" asp-page="/Account/Login">
                                <i class="fa-solid fa-right-to-bracket me-1"></i> Sign In
                            </a>
                            <a class="btn btn-sm btn-wl-primary rounded-pill px-3" asp-area="Identity" asp-page="/Account/Register">
                                <i class="fa-solid fa-user-plus me-1"></i> Register
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Body Content -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white pt-5 pb-4 mt-5 border-top border-secondary">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="wl-brand mb-3">
                        <i class="fa-solid fa-compass text-info"></i> Wanderlust Expeditions
                    </div>
                    <p class="text-secondary small">
                        Crafting extraordinary luxury and adventure journeys across 6 continents. Explore the world with authentic experiences, expert local guides, and small group privacy.
                    </p>
                    <div class="d-flex gap-3 text-secondary">
                        <a href="#" class="text-secondary"><i class="fa-brands fa-instagram fa-lg"></i></a>
                        <a href="#" class="text-secondary"><i class="fa-brands fa-facebook fa-lg"></i></a>
                        <a href="#" class="text-secondary"><i class="fa-brands fa-x-twitter fa-lg"></i></a>
                        <a href="#" class="text-secondary"><i class="fa-brands fa-youtube fa-lg"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="text-uppercase fw-bold text-light mb-3">Explore</h6>
                    <ul class="list-unstyled text-secondary small d-flex flex-column gap-2">
                        <li><a class="text-secondary text-decoration-none" asp-page="/Destinations/Index">Destinations</a></li>
                        <li><a class="text-secondary text-decoration-none" asp-page="/Packages/Index">Travel Packages</a></li>
                        <li><a class="text-secondary text-decoration-none" asp-page="/Index">Featured Trips</a></li>
                        <li><a class="text-secondary text-decoration-none" asp-page="/Packages/Index" asp-route-category="Adventure">Adventure Tours</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="h6 text-uppercase fw-bold text-light mb-3">Why Choose Us</div>
                    <ul class="list-unstyled text-secondary small d-flex flex-column gap-2">
                        <li><i class="fa-solid fa-check text-info me-2"></i> Small Group Experience (Max 12)</li>
                        <li><i class="fa-solid fa-check text-info me-2"></i> Concurrency-Safe Seat Reservations</li>
                        <li><i class="fa-solid fa-check text-info me-2"></i> Handpicked 4 & 5-Star Stays</li>
                        <li><i class="fa-solid fa-check text-info me-2"></i> 24/7 Dedicated Concierge</li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h6 class="text-uppercase fw-bold text-light mb-3">Newsletter</h6>
                    <p class="text-secondary small">Get private access to early-bird luxury deals and seasonal expedition alerts.</p>
                    <div class="input-group">
                        <input type="email" class="form-control form-control-sm bg-secondary bg-opacity-25 text-white border-secondary" placeholder="Enter email address">
                        <button class="btn btn-sm btn-wl-primary" type="button">Subscribe</button>
                    </div>
                </div>
            </div>
            <hr class="border-secondary my-4" />
            <div class="d-flex justify-content-between align-items-center flex-wrap small text-secondary">
                <div>&copy; @DateTime.UtcNow.Year Wanderlust Expeditions. Built with ASP.NET Core 10 & Entity Framework Core.</div>
                <div>Designed for travel enthusiasts worldwide.</div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
