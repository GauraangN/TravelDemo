@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Wanderlust Expeditions</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <!-- Custom Clean Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- Top Utility & Demo Bar (MakeMyTrip style utility header) -->
    <div class="top-utility-bar">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                <span>
                    <i class="fa-solid fa-sparkles text-warning me-1"></i>
                    <strong>Wanderlust Platform</strong> &bull; Concurrency-Safe Booking
                </span>
                <span class="d-none d-md-inline text-slate-400">|</span>
                <span class="d-none d-md-inline text-slate-300">
                    <i class="fa-solid fa-headset me-1 text-primary"></i> 24/7 Concierge: +1 (800) WANDER-LUX
                </span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="d-none d-lg-inline text-slate-400 small">Demo Accounts:</span>
                <span class="wl-badge-demo" title="Customer Login">
                    <i class="fa-solid fa-user me-1 text-warning"></i> alex@traveler.com
                </span>
                <span class="wl-badge-demo" style="background: rgba(245, 158, 11, 0.15); color: #fed7aa; border-color: rgba(245, 158, 11, 0.35);" title="Admin Login">
                    <i class="fa-solid fa-user-shield me-1 text-warning"></i> admin@wanderlust.com
                </span>
            </div>
        </div>
    </div>

    <!-- Header / Navigation Bar -->
    <header>
        <nav class="navbar navbar-expand-lg wl-navbar navbar-dark">
            <div class="container">
                <a class="wl-brand" asp-area="" asp-page="/Index">
                    <span class="wl-brand-badge">
                        <i class="fa-solid fa-compass"></i>
                    </span>
                    <span class="wl-brand-text">Wanderlust</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#wlNavbarContent" aria-controls="wlNavbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="wlNavbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                        <li class="nav-item">
                            <a class="wl-nav-link" asp-area="" asp-page="/Index">
                                <i class="fa-solid fa-house"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="wl-nav-link" asp-area="" asp-page="/Destinations/Index">
                                <i class="fa-solid fa-earth-americas"></i> Destinations
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="wl-nav-link" asp-area="" asp-page="/Packages/Index">
                                <i class="fa-solid fa-suitcase-rolling"></i> Travel Packages
                            </a>
                        </li>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="wl-nav-link" asp-area="" asp-page="/Bookings/Index">
                                    <i class="fa-solid fa-ticket"></i> My Bookings
                                </a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="wl-nav-link text-warning fw-bold" asp-area="" asp-page="/Admin/Index">
                                        <i class="fa-solid fa-sliders"></i> Admin Portal
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-light dropdown-toggle rounded-pill px-3 py-1" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-regular fa-user-circle me-1 text-warning"></i> @User.Identity?.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2" aria-labelledby="userMenu">
                                    <li>
                                        <a class="dropdown-item py-2" asp-page="/Bookings/Index">
                                            <i class="fa-solid fa-receipt me-2 text-warning"></i> My Expeditions
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
                                            <button type="submit" class="dropdown-item text-danger py-2">
                                                 <i class="fa-solid fa-right-from-bracket me-2"></i> Sign Out
                                             </button>
                                         </form>
                                     </li>
                                 </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-light rounded-pill px-3 py-1 fw-semibold" asp-area="Identity" asp-page="/Account/Login">
                                <i class="fa-solid fa-right-to-bracket me-1 text-warning"></i> Sign In
                            </a>
                            <a class="btn btn-sm btn-wl-primary rounded-pill px-3 py-1 fw-semibold" asp-area="Identity" asp-page="/Account/Register">
                                <i class="fa-solid fa-user-plus me-1"></i> Register
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Body Content -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Structured Modern Footer (Inspired by MakeMyTrip) -->
    <footer class="wl-footer pt-5 pb-4 mt-5">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="wl-brand mb-3">
                        <span class="wl-brand-badge" style="width: 32px; height: 32px; font-size: 0.95rem;">
                            <i class="fa-solid fa-compass"></i>
                        </span>
                        <span class="wl-brand-text fs-4">Wanderlust</span>
                    </div>
                    <p class="small text-slate-400 mb-4" style="line-height: 1.6;">
                        Crafting extraordinary luxury and adventure journeys across 6 continents. Explore the world with authentic experiences, certified guides, small-group exclusivity, and instant departure seat locks.
                    </p>
                    <div class="d-flex gap-3 text-slate-400">
                        <a href="#" class="p-2 bg-white bg-opacity-10 rounded-circle text-white d-inline-flex align-items-center justify-content-center" style="width: 34px; height: 34px;"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" class="p-2 bg-white bg-opacity-10 rounded-circle text-white d-inline-flex align-items-center justify-content-center" style="width: 34px; height: 34px;"><i class="fa-brands fa-facebook"></i></a>
                        <a href="#" class="p-2 bg-white bg-opacity-10 rounded-circle text-white d-inline-flex align-items-center justify-content-center" style="width: 34px; height: 34px;"><i class="fa-brands fa-x-twitter"></i></a>
                        <a href="#" class="p-2 bg-white bg-opacity-10 rounded-circle text-white d-inline-flex align-items-center justify-content-center" style="width: 34px; height: 34px;"><i class="fa-brands fa-youtube"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <div class="wl-footer-title">Holiday Types</div>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                        <li><a asp-page="/Index" asp-route-category="Beach">Beach Escapes</a></li>
                        <li><a asp-page="/Index" asp-route-category="Adventure">Mountain & Treks</a></li>
                        <li><a asp-page="/Index" asp-route-category="Culture">Cultural Heritage</a></li>
                        <li><a asp-page="/Index" asp-route-category="Luxury">Luxury Signature</a></li>
                        <li><a asp-page="/Index" asp-route-category="Family">Family Vacations</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <div class="wl-footer-title">Top Regions</div>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                        <li><a asp-page="/Destinations/Index" asp-route-region="Asia">Southeast Asia</a></li>
                        <li><a asp-page="/Destinations/Index" asp-route-region="Europe">European Alps</a></li>
                        <li><a asp-page="/Destinations/Index" asp-route-region="Africa">African Safaris</a></li>
                        <li><a asp-page="/Destinations/Index" asp-route-region="Americas">Patagonia & Andes</a></li>
                        <li><a asp-page="/Packages/Index">All Expeditions</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <div class="wl-footer-title">Wanderlust Club Newsletter</div>
                    <p class="small text-slate-400 mb-3">
                        Receive exclusive secret flash sales, early 2027 departure alerts, and personalized itinerary ideas.
                    </p>
                    <div class="input-group mb-3">
                        <input type="email" class="form-control bg-white bg-opacity-10 border-0 text-white rounded-start-pill px-3" placeholder="Enter your email...">
                        <button class="btn btn-wl-primary rounded-end-pill px-4" type="button">Join Club</button>
                    </div>
                    <div class="d-flex align-items-center gap-3 text-slate-400 small">
                        <span><i class="fa-solid fa-lock text-success me-1"></i> Safe & Encrypted</span>
                        <span><i class="fa-solid fa-bell-slash text-warning me-1"></i> No Spam Guarantee</span>
                    </div>
                </div>
            </div>

            <hr style="border-color: rgba(255, 255, 255, 0.08);" class="my-4" />

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 small text-slate-400">
                <div>
                    &copy; @DateTime.UtcNow.Year Wanderlust Expeditions Inc. All rights reserved.
                </div>
                <div class="d-flex gap-4">
                    <a href="#">Privacy Policy</a>
                    <a href="#">Terms of Service</a>
                    <a href="#">Security Guarantee</a>
                    <a href="#">Sitemap</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
